<?php


use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_webform_submission_form_alter().
 */
function dk_address_drupal_webform_submission_form_alter(array &$form, FormStateInterface $form_state, $form_id) {
  $webform = $form_state->getFormObject()->getEntity()->getWebform();

  // Only the forms you want. Remove this check to load it on all webforms.
  if (!in_array($webform->id(), ['ansoegning_om_medlemskab', 'betinget_indmeldelse'], TRUE)) {
    return;
  }

  $form['#attached']['library'][] = 'dk_address_drupal/adressevaelger';
  $form['#attached']['drupalSettings']['adressevaelger'] = [
    // Put your own token in settings.php: $settings['adressevaelger_token'] = '...';
    'token' => \Drupal\Core\Site\Settings::get('adressevaelger_token', 'adressevaelger123'),
  ];
}

function dk_address_drupal_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
/* @var Drupal\Core\Entity\FieldableEntityInterface $entity */
  $formObject = $form_state->getFormObject();
}